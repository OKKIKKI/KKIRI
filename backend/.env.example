# 명세 04_INTERFACE_SPEC.md 1.2절. 실제 값은 담당자끼리 따로 공유한다.
PORT=8080
# QR에 넣을 웹 주소
KKIRI_WEB_BASE=http://localhost:5173
# 무로그인 세션: 시동이 꺼진 뒤 입력이 없으면 종료까지(초) (명세 v1.3, Q-006)
PAUSE_TIMEOUT_SEC=900
# 계정 세션: 마지막 활동 후 종료까지(초)
ACCOUNT_SESSION_TTL_SEC=86400
# 예약 세션: 차가 안 붙으면 종료(초)
RESERVE_ATTACH_TIMEOUT_SEC=900
# QR 만료(초)
QR_TTL_SEC=1800
# 음소거 차 대상 긴급 재전송 제한(초)
URGENT_LIMIT_SEC=30
# 경유지 제안 무응답 처리(초)
PROPOSAL_TIMEOUT_SEC=60
# 차량 WebSocket이 이만큼 끊기면 DISCONNECTED로 알림(초). 명세 4.1. 없으면 30
CAR_DISCONNECT_SEC=30
# 같은 참가자의 음악 다음/이전 곡 연타 제한(초). 명세 3.5 R-43. 없으면 3
MUSIC_CONTROL_LIMIT_SEC=3
# 서버 자기 외부 주소(명세 v1.8). 카카오 콜백 주소 {KKIRI_API_BASE}/v1/auth/kakao/callback 을 만든다.
# 웹 .env의 KKIRI_API_BASE와 같은 값. 카카오 콘솔 Redirect URI에 같은 주소가 등록돼 있어야 한다. 끝에 / 없이.
# 카카오 키가 없으면 비워 둬도 된다.
KKIRI_API_BASE=http://localhost:8080
# 카카오 로그인(D-10). ⚠ 비밀값: 값은 .env에만, 레포·채팅에 올리지 않는다. 비우면 카카오 로그인 꺼짐(DEV_LOGIN만)
# REST API 키
KAKAO_REST_API_KEY=
# 클라이언트 시크릿(카카오 문서: REST API 키는 기본 ON. 콘솔에서 껐으면 비움)
KAKAO_CLIENT_SECRET=
# 1이면 카카오 대신 시드 첫 사용자로 개발용 로그인 (D-10, 시연 기본). 카카오로 로그인하려면 0
DEV_LOGIN=1
# Spotify(D-09). ⚠ 임시 이름(Q-BE-002 승인·명세 1.2 반영 전). ⚠ 비밀값: 값은 .env에만, 레포·채팅에 올리지 않는다
# 둘 다 채우면 실제 Spotify, 하나라도 비우면 목업 음악(지금까지와 같음)
# 콜백 = {KKIRI_API_BASE}/v1/music/spotify/callback. Spotify는 HTTPS 또는 127.0.0.1 주소만 받는다(LAN http 주소 불가)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 지금 재생 중인 곡을 서버가 다시 읽는 간격(초). 임시 이름. 없으면 5
MUSIC_POLL_SEC=5
